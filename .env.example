# Client and server. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never import these from a client component.
SUPABASE_SECRET_KEY=
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=

# Optional. Set to true to log the full raw Deepgram response for each
# transcription. Useful when a transcript looks wrong but the request succeeded.
DEEPGRAM_DEBUG=

# Local only, used by `npm run db:push` to apply supabase/migrations.
# The app never reads this. Do not set it in Vercel.
SUPABASE_DB_URL=
